# Puerto HTTP (opcional en local: si no se define usa 3000).
# En Render lo asigna la plataforma automáticamente; no lo definas allí.
# En local el servidor escucha solo en 127.0.0.1 (no lo alcanza otro equipo de tu red), porque el
# usuario de desarrollo no pide credenciales y la base es la compartida. En Render escucha en 0.0.0.0, y
# en Azure también, porque la imagen (Dockerfile) define NODE_ENV=production. En Azure: PORT=3000, el
# puerto de destino del ingress.
# PORT=3000

# Orígenes permitidos por CORS, separados por comas y sin "/" final.
# Local (por defecto): el dashboard web con Vite corre en el puerto 5173.
CORS_ORIGINS=http://localhost:5173
# Si además usas la app móvil en modo web (Expo web), agrega http://localhost:8081
# En Render (backend desplegado): define esta variable en el panel de Render, no aquí, con
#   la URL de Vercel + http://localhost:5173 (para probar un front local contra Render):
# CORS_ORIGINS=http://localhost:5173,https://frontend-rose-gamma-96.vercel.app
# La app móvil nativa no usa CORS.

# Commit desplegado, que GET /v1/health devuelve en "commit" y el CI compara con el del push.
# - GIT_COMMIT: la define el pipeline de Azure (job deploy-azure de ci-cd.yml) con el SHA corto. No se
#   escribe a mano. Si está definida y no vacía, gana sobre RENDER_GIT_COMMIT.
# - RENDER_GIT_COMMIT: la define Render solo, con el SHA del commit que desplegó: no la definas en el panel.
# En local no se define ninguna, y el health responde "commit": null.
# GIT_COMMIT=
# RENDER_GIT_COMMIT=

# PostgreSQL (Neon). Copia la cadena de conexión desde el panel de Neon.
# TLS según sslmode: verify-full cifra y verifica el certificado (Azure Database for PostgreSQL: úsalo así);
# require cifra sin verificarlo (Neon); sin sslmode no hay TLS (Docker local).
DATABASE_URL=postgresql://usuario:password@host/nombre_db?sslmode=require

# Solo para `npm run test:db` (CLAUDE.md §11, "Pruebas"): la URL de la base de PRUEBAS, nunca la de
# desarrollo. Va en `.env.test` (ignorado por git), no aquí.
# TEST_DATABASE_URL=

# Redis/Valkey. En local: redis://localhost:6379
REDIS_URL=redis://default:password@host:puerto

# ID genérico del proyecto Firebase usado para verificar ID tokens; no es un secreto.
# Obligatoria si el usuario de desarrollo está deshabilitado. En Render, configúrala en el panel.
FIREBASE_PROJECT_ID=mi-proyecto-firebase
# Solo para el emulador de Firebase en local. No la definas en Render: en un ambiente desplegado,
# si está definida, la app no arranca.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Llave de Google Geocoding API para GET /v1/geocode (dirección → coordenadas). Opcional: sin ella la
# app arranca y GET /v1/geocode responde 503 GEOCODING_UNAVAILABLE. Es un secreto: la crea el equipo
# de Google Cloud (consola de Google Cloud → APIs y servicios → Credenciales, restringida a
# Geocoding API) y se entrega por canal privado. Va en tu .env y en el panel de Render, nunca aquí.
GOOGLE_GEOCODING_API_KEY=

# Vigencia de la microreserva, en minutos enteros entre 2 y 15 (CLAUDE.md §12.1). Opcional: sin
# definir, 15. Un valor inválido (texto, vacío, fuera de 2 a 15) impide que la app arranque.
# En Render o Azure: 15 normalmente; 3 solo durante la demo de expiración.
RESERVATION_TTL_MINUTES=15

# Proceso que vence las reservas cada 15 s y al arrancar (CLAUDE.md §12.5): true o false. Opcional: sin
# definir, true. Otro valor (también vacío) impide que la app arranque. En Render o Azure: true.
RESERVATION_EXPIRY_ENABLED=true

# Correo del administrador de DiNNo (rol platform_admin), solo para `npm run seed` (CLAUDE.md §11,
# "Administrador"). Opcional: si está definida, el seed crea esa cuenta (o la deja como está si ya es
# platform_admin; si existe con otro rol, se detiene sin cambiar nada). La app no la lee: no hace
# falta en Render. Defínela solo en el proceso del seed, por ejemplo:
#   PLATFORM_ADMIN_EMAIL=admin@ejemplo.com npm run seed
# PLATFORM_ADMIN_EMAIL=

# Notificaciones push de la reserva (Sprint 4, Firebase Cloud Messaging). Opcionales: sin ninguna, la API
# arranca igual y no envía notificaciones (lo dice una vez en el log). Es la cuenta de servicio del proyecto de
# Firebase (consola de Firebase → Configuración del proyecto → Cuentas de servicio → Generar nueva clave
# privada). Es un SECRETO: nunca va en el repositorio, ni en el chat, ni en el log.
# Usa una de las dos:
# - FIREBASE_SERVICE_ACCOUNT_FILE: la ruta del archivo JSON. En local, fuera del repo (por ejemplo
#   ~/.dinno/firebase-service-account.json). En Render, un Secret File: /etc/secrets/firebase-service-account.json.
# - FIREBASE_SERVICE_ACCOUNT_JSON: el contenido del JSON en una sola línea (para Azure o CI).
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Límite de peticiones (Sprint 4, CLAUDE.md §12.14 y §11 "Límite de peticiones y cabeceras de seguridad").
# Las tres son opcionales: sin definir, el límite está activo, con las cifras normales.
# Un valor inválido impide que la app arranque.
# - RATE_LIMIT_ENABLED: true o false. Solo false durante una prueba de carga, y se vuelve a dejar.
# - RATE_LIMIT_FACTOR: entero de 1 a 1000 que multiplica todos los límites (prueba de carga). Normal: sin definir.
# - TRUST_PROXY_HOPS: cuántos proxies hay delante de la API, para leer la IP real de X-Forwarded-For.
#   Sin definir: 1 desplegado (Render o el ingress de Azure Container Apps) y 0 en local. No lo subas sin motivo:
#   con un valor de más, el cliente elige su IP.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_FACTOR=1
# TRUST_PROXY_HOPS=

# Usuario de desarrollo: identifica al usuario actual en local cuando Firebase no se usa.
# Solo para local. En un ambiente desplegado (variable RENDER o NODE_ENV=production), si está en true
# la app no arranca. No la definas en Render.
DEV_USER_ENABLED=true
# UUID del usuario (tabla users) que se usa por defecto; lo imprime `npm run seed`. Para cambiarlo
# sin reiniciar, envía la cabecera x-dev-user-id con otro UUID (por ejemplo, el usuario sin
# restaurante para el onboarding).
DEV_USER_ID=3f2b8c1e-5d4a-4e7b-9c6f-1a2b3c4d5e6f
