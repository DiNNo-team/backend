# Puerto HTTP (opcional en local: si no se define usa 3000).
# En Render lo asigna la plataforma automáticamente; no lo definas allí.
# En local el servidor escucha solo en 127.0.0.1 (no lo alcanza otro equipo de tu red), porque el
# usuario de desarrollo no pide credenciales y la base es la compartida. En Render escucha en 0.0.0.0.
# PORT=3000

# Orígenes permitidos por CORS, separados por comas y sin "/" final.
# Local (por defecto): el dashboard web con Vite corre en el puerto 5173.
CORS_ORIGINS=http://localhost:5173
# Si además usas la app móvil en modo web (Expo web), agrega http://localhost:8081
# En Render (backend desplegado): define esta variable en el panel de Render, no aquí, con
#   la URL de Vercel + http://localhost:5173 (para probar un front local contra Render):
# CORS_ORIGINS=http://localhost:5173,https://frontend-rose-gamma-96.vercel.app
# La app móvil nativa no usa CORS.

# Commit desplegado, que GET /v1/health devuelve en "commit" y el CI compara con el del push.
# Lo define Render solo, con el SHA del commit que desplegó: no lo definas en el panel de Render.
# En local no se define, y el health responde "commit": null.
# RENDER_GIT_COMMIT=

# PostgreSQL (Neon). Copia la cadena de conexión desde el panel de Neon.
DATABASE_URL=postgresql://usuario:password@host/nombre_db?sslmode=require

# Redis/Valkey. En local: redis://localhost:6379
REDIS_URL=redis://default:password@host:puerto

# ID genérico del proyecto Firebase usado para verificar ID tokens; no es un secreto.
# Obligatoria si el usuario de desarrollo está deshabilitado. En Render, configúrala en el panel.
FIREBASE_PROJECT_ID=mi-proyecto-firebase
# Solo para el emulador de Firebase en local. No la definas en Render: en un ambiente desplegado,
# si está definida, la app no arranca.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Usuario de desarrollo: identifica al usuario actual en local cuando Firebase no se usa.
# Solo para local. En un ambiente desplegado (variable RENDER o NODE_ENV=production), si está en true
# la app no arranca. No la definas en Render.
DEV_USER_ENABLED=true
# UUID del usuario (tabla users) que se usa por defecto; lo imprime `npm run seed`. Para cambiarlo
# sin reiniciar, envía la cabecera x-dev-user-id con otro UUID (por ejemplo, el usuario sin
# restaurante para el onboarding).
DEV_USER_ID=3f2b8c1e-5d4a-4e7b-9c6f-1a2b3c4d5e6f
