# Puerto HTTP (opcional en local: si no se define usa 3000).
# En Render lo asigna la plataforma automáticamente; no lo definas allí.
# PORT=3000

# Orígenes permitidos por CORS, separados por comas y sin "/" final.
# Local (por defecto): el dashboard web con Vite corre en el puerto 5173.
CORS_ORIGINS=http://localhost:5173
# Si además usas la app móvil en modo web (Expo web), agrega http://localhost:8081
# En Render (backend desplegado): define esta variable en el panel de Render, no aquí, con
#   la URL de Vercel + http://localhost:5173 (para probar un front local contra Render):
# CORS_ORIGINS=http://localhost:5173,https://frontend-rose-gamma-96.vercel.app
# La app móvil nativa no usa CORS.

# PostgreSQL (Neon). Copia la cadena de conexión desde el panel de Neon.
DATABASE_URL=postgresql://usuario:password@host/nombre_db?sslmode=require

# Redis/Valkey. En local: redis://localhost:6379
REDIS_URL=redis://default:password@host:puerto
